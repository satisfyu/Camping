{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}\n${credits}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Let-s-Do-Collection/Let-s-Do-Collection"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.satisfy.camping.CampingFabric"
        ],
        "client": [
            "net.satisfy.camping.CampingClientFabric"
        ],
        "modmenu": [
            "net.satisfy.camping.core.config.ModMenu"
        ],
        "jei_mod_plugin": [
            "net.satisfy.camping.optional.FabricJEICampingPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.0",
        "fabric-api": "*",
        "minecraft": "1.21.1",
        "java": ">=21",
        "cloth-config": "*"
    },
    "suggests": {
        "modmenu": "*",
        "trinkets": ">=3.10.0"
    }
}