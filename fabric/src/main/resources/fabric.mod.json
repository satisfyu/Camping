{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}\n${credits}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/lets-do-camping",
        "sources": "https://github.com/satisfyu/Camping"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.satisfy.camping.CampingFabric"
        ],
        "client": [
            "net.satisfy.camping.CampingClientFabric"
        ],
        "modmenu": [
            "net.satisfy.camping.core.config.ModMenu"
        ],
        "jei_mod_plugin": [
            "net.satisfy.camping.optional.FabricJEICampingPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "cloth-config": ">=11.1.136"
    },
    "suggests": {
        "modmenu": ">=7.2.2",
        "trinkets": ">=3.7.1"
    }
}
  